   "fillStyle": "solid",
   "roundness": null,
   "id": "t3",
   "type": "text",
   "x": 40,
   "y": 96,
   "width": 1049,
   "height": 23,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "2. SWAP the top with the last spot: the biggest number is now in its final place. The heap gets 1 smaller.",
   "originalText": "2. SWAP the top with the last spot: the biggest number is now in its final place. The heap gets 1 smaller.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 18
  },
  {
   "angle": 0,
   "strokeWidth": 2,
