   "id": "t2",
   "type": "text",
   "x": 40,
   "y": 70,
   "width": 1079,
   "height": 23,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "1. BUILD a max heap: every parent is bigger than its children, so the biggest number is at the top (index 0).",
   "originalText": "1. BUILD a max heap: every parent is bigger than its children, so the biggest number is at the top (index 0).",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 18
  },
  {
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "f",
   "seed": 1,
   "version": 1,
   "versionNonce": 1,
