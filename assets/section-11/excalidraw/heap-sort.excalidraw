   "id": "t4",
   "type": "text",
   "x": 40,
   "y": 122,
   "width": 1030,
   "height": 23,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "3. HEAPIFY: the new top sinks down (swap with its bigger child) until the heap is fixed. Repeat 2 and 3.",
   "originalText": "3. HEAPIFY: the new top sinks down (swap with its bigger child) until the heap is fixed. Repeat 2 and 3.",
