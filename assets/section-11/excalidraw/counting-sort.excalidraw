   "type": "text",
   "x": 40,
   "y": 544,
   "width": 1038,
   "height": 21,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "text": "Fast: one pass to count + one pass over the range (k) → O(n + k). But it needs a box for every possible number,",
   "originalText": "Fast: one pass to count + one pass over the range (k) → O(n + k). But it needs a box for every possible number,",
