   "width": 1079,
   "height": 23,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "partition(): pivot = last item. j walks through the part. If arr[j] < pivot: i++ and swap arr[i] with arr[j].",
   "originalText": "partition(): pivot = last item. j walks through the part. If arr[j] < pivot: i++ and swap arr[i] with arr[j].",
