   "id": "t2",
   "type": "text",
   "x": 40,
   "y": 70,
   "width": 1262,
   "height": 21,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "partition(low, high): pivot = arr[high]. i = low - 1. For each j from low to high - 1: if arr[j] < pivot → i++ and swap arr[i], arr[j].",
   "originalText": "partition(low, high): pivot = arr[high]. i = low - 1. For each j from low to high - 1: if arr[j] < pivot → i++ and swap arr[i], arr[j].",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "angle": 0,
   "strokeWidth": 2,
