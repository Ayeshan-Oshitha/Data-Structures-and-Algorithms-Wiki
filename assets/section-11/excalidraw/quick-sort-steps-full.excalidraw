   "x": 40,
   "y": 96,
   "width": 1019,
   "height": 21,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "Then swap the pivot into i + 1 (its final place). quickSort then repeats on the left part and the right part.",
   "originalText": "Then swap the pivot into i + 1 (its final place). quickSort then repeats on the left part and the right part.",
