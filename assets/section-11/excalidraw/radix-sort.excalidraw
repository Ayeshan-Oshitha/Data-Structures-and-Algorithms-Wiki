   "id": "t250",
   "type": "text",
   "x": 40,
   "y": 590,
   "width": 1225,
   "height": 21,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "text": "Look at pass 1: the orange ones digits go 0, 0, 2, 2, 4, 5, 5, 6. Pass 2 does the same with the tens, and pass 3 with the hundreds.",
   "originalText": "Look at pass 1: the orange ones digits go 0, 0, 2, 2, 4, 5, 5, 6. Pass 2 does the same with the tens, and pass 3 with the hundreds.",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 17
  },
