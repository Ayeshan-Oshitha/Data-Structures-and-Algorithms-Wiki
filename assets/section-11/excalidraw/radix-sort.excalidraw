   "id": "t251",
   "type": "text",
   "x": 40,
   "y": 616,
   "width": 1187,
   "height": 21,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "text": "3 passes because the biggest number (802) has 3 digits. Each pass is O(n), so the total is O(n × k), with k = number of digits.",
   "originalText": "3 passes because the biggest number (802) has 3 digits. Each pass is O(n), so the total is O(n × k), with k = number of digits.",
