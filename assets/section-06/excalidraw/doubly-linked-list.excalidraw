      "type": "text",
      "x": 40,
      "y": 430,
      "width": 990,
      "height": 25,
      "text": "Singly: only next  →  can't go back.   Doubly: next + prev  →  both ways, but more memory.",
      "originalText": "Singly: only next  →  can't go back.   Doubly: next + prev  →  both ways, but more memory.",
