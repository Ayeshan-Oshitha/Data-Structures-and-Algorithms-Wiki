      "type": "text",
      "x": 40,
      "y": 350,
      "width": 460,
      "height": 55,
      "text": "black → next: go forward (head → tail)\nred ← prev: go backward (tail → head)",
      "originalText": "black → next: go forward (head → tail)\nred ← prev: go backward (tail → head)",
      "fontSize": 22,
      "fontFamily": 5,
